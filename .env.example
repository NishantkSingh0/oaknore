# ─────────────────────────────────────────────────────────
#  PMS3 — Environment Configuration EXAMPLE
#  Copy to .env and fill in your real credentials.
# ─────────────────────────────────────────────────────────

APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pms3
DB_USER=pms3_user
DB_PASSWORD=CHANGEME
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_TIMEOUT=30s
DATABASE_URL=postgres://pms3_user:CHANGEME@localhost:5432/pms3?sslmode=disable

JWT_SECRET=CHANGEME_use_a_long_random_string_at_least_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
AWS_S3_BUCKET=CHANGEME
AWS_S3_BASE_URL=https://CHANGEME.s3.us-east-1.amazonaws.com
AWS_S3_PRESIGN_EXPIRY=15m

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

WS_PING_INTERVAL=30s
WS_PONG_WAIT=60s
WS_WRITE_WAIT=10s

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGEME
SMTP_FROM=PMS3 <noreply@example.com>

LOG_LEVEL=info
LOG_FORMAT=json